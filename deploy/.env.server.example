# Sunucudaki Java API'nin ayarlari. Bu dosyayi .env olarak kopyalayin; .env git'e girmez.
#
#   cp .env.server.example .env

# Konteyner ve imaj adlarinin onu (Laravel'inkinden farkli olmali)
COMPOSE_PROJECT_NAME=olivamore-dev-java

# Disariya acilan port: Laravel'in kullandigi port (dev 8001). Laravel'in app konteyneri
# durdurulmadan bu port bos olmaz.
APP_PORT=8001

# Laravel'in klasoru ve Docker agi (Laravel .env'indeki COMPOSE_PROJECT_NAME + "_default")
LARAVEL_DIR=/srv/olivamore/dev/olive_oil_back
LARAVEL_NETWORK=olivamore-dev_default

# Veritabani: Laravel .env'indeki DB_DATABASE / DB_USERNAME / DB_PASSWORD ile ayni
DB_DATABASE=olivamore
DB_USERNAME=olivamore
DB_PASSWORD=

# JVM bellegi (konteynerin gordugu bellegin yuzdesi)
#JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=60
