# Sunucudaki Java API'nin ayarlari. Bu dosyayi .env olarak kopyalayin; .env git'e girmez.
#
#   cp .env.server.example .env

# Konteyner, imaj ve volume adlarinin onu
COMPOSE_PROJECT_NAME=olivamore-dev

# Disariya acilan port
APP_PORT=8001

# Veritabani (compose.server.yaml'daki PostgreSQL konteyneri bu degerlerle kurulur)
DB_DATABASE=olivamore
DB_USERNAME=olivamore
DB_PASSWORD=

# Uygulama surumlerinin (APK) bulundugu klasor
#RELEASES_DIR=./releases

# JVM bellegi (konteynerin gordugu bellegin yuzdesi)
#JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=50

# ---------------------------------------------------------------------------
# JWT imza anahtari (zorunlu: yoksa uygulama baslamaz). Gercek anahtar git'e girmez.
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.pem
# Icerigi tek satira, satir sonlari \n olacak sekilde yazin.
# ---------------------------------------------------------------------------
JWT_PRIVATE_KEY=
#JWT_KEY_ID=olive-1
