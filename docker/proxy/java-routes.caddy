# Java'ya tasinmis endpoint'ler. Her modul tamamlanma kriterini gecince buraya eklenir
# (bkz. docs/MIGRATION_ROADMAP.md). Sira onemli degil: Caddy yol eslesmelerini
# ozgulluge gore siralar, eslesmeyen her istek Caddyfile'daki Laravel bloguna duser.
#
# Java'nin saglik kontrolu, proxy uzerinden dogrulama icin
@java_actuator path /java/actuator/*
handle @java_actuator {
	uri strip_prefix /java
	reverse_proxy {$JAVA_UPSTREAM} {
		header_down X-Served-By java
	}
}

# Faz 2: identity (auth, kullanicilar, roller, izinler)
@java_identity path /api/auth/* /api/user /api/users /api/users/* /api/roles /api/roles/* /api/permissions
handle @java_identity {
	reverse_proxy {$JAVA_UPSTREAM} {
		header_down X-Served-By java
	}
}

# Faz 3: app-release (mobil uygulama guncellemesi)
@java_app_release path /api/app/version /api/app/download
handle @java_app_release {
	reverse_proxy {$JAVA_UPSTREAM} {
		header_down X-Served-By java
	}
}

# Faz 4: catalog (urun kategorileri ve tipleri, attribute tanimlari, proses tipleri, hatlar, asamalar)
@java_catalog path /api/production-products /api/production-products/* /api/production-product-types /api/production-product-types/* /api/production-lines /api/production-lines/* /api/process-types /api/process-types/* /api/stage-extension-types /api/attribute-definitions
handle @java_catalog {
	reverse_proxy {$JAVA_UPSTREAM} {
		header_down X-Served-By java
	}
}

# Faz 4: zeytin tedarikcileri ve tarlalari (ambalaj tedarikcileri /api/product-suppliers Faz 7'de)
@java_suppliers path /api/suppliers /api/suppliers/*
handle @java_suppliers {
	reverse_proxy {$JAVA_UPSTREAM} {
		header_down X-Served-By java
	}
}

# Faz 5a + 5c: tanklar (hareket gecmisi dahil) ve stok hareketleri
@java_storage_units path /api/storage-units /api/storage-units/* /api/storage-movements/*
handle @java_storage_units {
	reverse_proxy {$JAVA_UPSTREAM} {
		header_down X-Served-By java
	}
}

# Faz 5b: materyaller (liste, detay, soy grafi)
@java_materials path /api/materials /api/materials/*
handle @java_materials {
	reverse_proxy {$JAVA_UPSTREAM} {
		header_down X-Served-By java
	}
}

# Faz 6a: uretim partileri (liste, takvim, ekleme, guncelleme, silme)
@java_production_batches path /api/production-batches /api/production-batches/*
handle @java_production_batches {
	reverse_proxy {$JAVA_UPSTREAM} {
		header_down X-Served-By java
	}
}

# Faz 6b: prosesler (detay, alan degerleri, durum, onay/red)
@java_batch_processes path /api/batch-processes/*
handle @java_batch_processes {
	reverse_proxy {$JAVA_UPSTREAM} {
		header_down X-Served-By java
	}
}
