# Bu dosyayi .env olarak kopyalayin. .env git'e girmez.
# Hem Spring Boot (spring.config.import) hem docker compose bu dosyayi okur.

# ---------------------------------------------------------------------------
# Veritabani: asagidaki iki secenekten biri
# ---------------------------------------------------------------------------

# (A) Bilgisayara kurulu PostgreSQL (varsayilan). Bir kez, postgres kullanicisiyla:
#   psql -U postgres -c "CREATE ROLE olivamore LOGIN PASSWORD 'olivamore'"
#   psql -U postgres -c "CREATE DATABASE olivamore OWNER olivamore"
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=olivamore
DB_USERNAME=olivamore
DB_PASSWORD=olivamore

# (B) Docker'daki PostgreSQL: asagidaki satiri acin. Konteyner ilk aciliste yukaridaki
# DB_DATABASE / DB_USERNAME / DB_PASSWORD ile olusturulur; DB_HOST ve DB_PORT kullanilmaz.
#COMPOSE_PROFILES=docker-db

# ---------------------------------------------------------------------------
# GECIS DONEMI: Laravel ile birlikte calisma (-Dspring-boot.run.profiles=laravel)
# Laravel kapatilinca bu bolum silinir.
# ---------------------------------------------------------------------------
# Laravel'in sifresi: ../Olive_Production_Tracking_App_Back/olive_oil_back/.env icindeki DB_PASSWORD
LARAVEL_DB_PASSWORD=
